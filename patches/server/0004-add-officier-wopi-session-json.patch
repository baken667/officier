+function getEditorSessionJson(req, res) {
+  return co(function* () {
+    const params = createEditorParams(req);
+    const ctx = new operationContext.Context();
+    try {
+      const result = yield prepareEditorSession(req, ctx, params, 'officierWopiSession');
+      if (!result.ok) {
+        res.status(params.statusCode || 400).json({
+          error: 'OFFICIER_WOPI_SESSION_FAILED',
+          statusCode: params.statusCode || 400
+        });
+        return;
+      }
+
+      res.json({
+        id: params.key,
+        mode: 'wopi',
+        documentTitle: result.documentTitle,
+        fileType: result.fileType,
+        canEdit: result.canEdit,
+        bootstrap: params
+      });
+    } catch (err) {
+      ctx.logger.error('officierWopiSession error: %s', err.stack);
+      res.sendStatus(500);
+    } finally {
+      ctx.logger.info('officierWopiSession end');
+    }
+  });
