+'use strict';
+
+const express = require('express');
+const commonDefines = require('../../../Common/sources/commondefines');
+const operationContext = require('../../../Common/sources/operationContext');
+
+const router = express.Router();
+
+function buildManifest() {
+  const buildVersion = commonDefines.buildVersion || 'unknown';
+  const buildNumber = commonDefines.buildNumber || 'unknown';
+
+  return {
+    protocolVersion: 1,
+    buildId: `officier-${buildVersion}-${buildNumber}`,
+    sdkVersion: `${buildVersion}.${buildNumber}`,
+    assets: [],
+    capabilities: {
+      word: false,
+      wopi: true,
+      noIframe: true
+    },
+    limitations: [
+      'OFFICIER_DIRECT_WORD_ADAPTER_MISSING'
+    ]
+  };
+}
+
+router.get('/runtime/manifest.json', async (req, res) => {
+  const ctx = new operationContext.Context();
+  try {
+    ctx.initFromRequest(req);
+    await ctx.initTenantCache();
+    res.setHeader('Cache-Control', 'no-store');
+    res.json(buildManifest());
+  } catch (err) {
+    ctx.logger.error('officier/runtime/manifest.json error: %s', err.stack);
+    res.sendStatus(500);
+  }
+});
+
+module.exports = router;
