+function buildDirectWordAdapterScript() {
+  return `(function () {
+  'use strict';
+
+  function OfficierDirectRuntimeError(code, message) {
+    this.name = 'OfficierDirectRuntimeError';
+    this.code = code;
+    this.message = message;
+    if (Error.captureStackTrace) Error.captureStackTrace(this, OfficierDirectRuntimeError);
+  }
+  OfficierDirectRuntimeError.prototype = Object.create(Error.prototype);
+  OfficierDirectRuntimeError.prototype.constructor = OfficierDirectRuntimeError;
+
+  function assertNoIframe(container) {
+    if (container && container.querySelector && container.querySelector('iframe')) {
+      throw new OfficierDirectRuntimeError('OFFICIER_IFRAME_DETECTED', 'Officier direct runtime created an iframe');
+    }
+  }
+
+  window.OfficierDirectRuntime = Object.freeze({
+    async mountWord(context) {
+      if (!context || !context.container || !context.session || !context.manifest) {
+        throw new OfficierDirectRuntimeError('OFFICIER_RUNTIME_LOAD_FAILED', 'Invalid Officier direct runtime mount context');
+      }
+
+      assertNoIframe(context.container);
+      throw new OfficierDirectRuntimeError(
+        'OFFICIER_DIRECT_SDK_BRIDGE_MISSING',
+        'Officier direct word adapter loaded, but the SDK bridge is not wired yet'
+      );
+    }
+  });
+})();\n`;
+}
